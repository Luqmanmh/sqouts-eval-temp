# Signs the login JWTs. While the Django backend still runs, use its SECRET_KEY
# so a session started on one backend is accepted by the other.
SECRET_KEY=change-me
DEBUG=True
CORS=http://localhost:3000

# Matches the db service in ../docker-compose.yml
DB_NAME=eval_bot
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5436

# Matches the redis service in ../docker-compose.yml. This backend's worker
# listens on its own queue (eval_api), so it can share Redis with Django's.
CELERY_BROKER_URL=redis://localhost:6380/0

# Run files (recordings, transcripts, logs). Relative to eval_platform_be/.
# Use ../../eval-bot/eval_platform_be/files to share runs with the Django backend.
MEDIA_ROOT=files

# Tester and judge LLM (langchain_anthropic reads this name)
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
